        <source_title>5.黑板樹者<gn id="135">長老</gn><gn id="424">阿波陀那</gn></source_title>
        <relevant/>
        <title>黑板樹者長老阿波陀那</title>
        <mtime>2025-08-16 01:04:22 +0800</mtime>
        <ctime/>
