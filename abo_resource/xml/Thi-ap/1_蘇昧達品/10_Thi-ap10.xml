        <source_title>10.水施與者<gn id="135">長老</gn>尼<gn id="424">阿波陀那</gn></source_title>
        <relevant/>
        <title>水施與者長老尼阿波陀那</title>
        <mtime>2025-08-16 01:05:32 +0800</mtime>
        <ctime/>
    </meta>
    <head/>
