        <source_title>3.床施與者<g135>長老</g135><g424>阿波陀那</g424></source_title>
        <relevant/>
        <title>床施與者長老阿波陀那</title>
        <mtime>2026-03-02 23:26:16 +0800</mtime>
        <ctime/>
        <head/>
