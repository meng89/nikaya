        <source_title>4.水井施與者<g135>長老</g135><g424>阿波陀那</g424></source_title>
        <relevant/>
        <title>水井施與者長老阿波陀那</title>
        <mtime>2025-08-16 01:04:48 +0800</mtime>
        <ctime/>
        <head/>
