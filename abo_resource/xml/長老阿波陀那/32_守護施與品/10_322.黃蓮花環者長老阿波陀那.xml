        <source_title>10.黃蓮花環者<g135>長老</g135><g424>阿波陀那</g424></source_title>
        <relevant/>
        <title>黃蓮花環者長老阿波陀那</title>
        <mtime>2025-08-16 01:05:34 +0800</mtime>
        <ctime/>
        <head/>
