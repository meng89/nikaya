        <source_title>4.葫蘆花供養者<g135>長老</g135><g424>阿波陀那</g424></source_title>
        <relevant/>
        <title>葫蘆花供養者長老阿波陀那</title>
        <mtime>2025-08-16 01:05:46 +0800</mtime>
        <ctime/>
        <head/>
