        <source_title>7.新芽供養者<g135>長老</g135><g424>阿波陀那</g424></source_title>
        <relevant/>
        <title>新芽供養者長老阿波陀那</title>
        <mtime>2025-08-16 01:04:08 +0800</mtime>
        <ctime/>
        <head/>
