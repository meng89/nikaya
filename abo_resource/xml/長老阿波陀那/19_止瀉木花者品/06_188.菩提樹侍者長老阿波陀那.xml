        <source_title>6.菩提樹侍者<g135>長老</g135><g424>阿波陀那</g424></source_title>
        <relevant/>
        <title>菩提樹侍者長老阿波陀那</title>
        <mtime>2025-08-16 01:05:30 +0800</mtime>
        <ctime/>
        <head/>
